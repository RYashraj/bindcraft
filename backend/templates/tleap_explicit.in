# BindCraft tleap input — Explicit Solvent (TIP3P octahedral box)
# Generated preset: {{PRESET_LABEL}}
# Protein FF: {{PROTEIN_FF}} | Ligand FF: {{LIGAND_FF}} | Water: {{WATER_MODEL}}
# DO NOT EDIT THE {{PLACEHOLDER}} MARKERS — they are filled by BindCraft.

# Load force field parameters
source leaprc.protein.ff14SB
source leaprc.{{LIGAND_FF}}
source leaprc.water.tip3p

# Load ligand parameters
loadamberparams {{LIGAND_NAME}}.frcmod
{{LIGAND_NAME}} = loadmol2 {{LIGAND_NAME}}_gaff2.mol2

# Load cleaned complex
complex = loadpdb {{PDB_STEM}}_clean.pdb

# Check for problems
check complex

# Add explicit water box (TIP3P octahedral, {{BOX_PADDING}} Å padding)
solvateoct complex TIP3PBOX {{BOX_PADDING}}

# Add counterions to neutralise
addions complex Na+ 0
addions complex Cl- 0

# Save topology and coordinates
saveamberparm complex complex.prmtop complex.inpcrd

# Summary
desc complex

quit

# BindCraft Configuration
# Copy this file to .env and adjust values for your setup

# WSL2 distribution name (run `wsl --list` to see yours)
WSL_DISTRO=Ubuntu

# Path to AmberTools bin directory INSIDE WSL (where pdb4amber, antechamber, etc. live)
AMBERTOOLS_BIN=/usr/local/miniconda3/envs/ambertools/bin

# Server settings
HOST=127.0.0.1
PORT=8000

# Storage directories (relative to repo root, or absolute paths)
PROJECTS_DIR=./projects
DEMO_DIR=./demo

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
